#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <130>;
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-on-release;
        };
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <130>;
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-on-release;
        };
        ltm: layer_tap_mo {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <130>;
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            bindings = <&mo>, <&kp>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base0 {
            display-name = "BASE";
            bindings = <

&kp ESC   &kp Q       &kp W        &kp E        &kp R         &kp T        &kp Y     &kp U         &kp I        &kp O         &kp P          &kp BSPC 
&kp GRAVE &hml LGUI A &hml LALT S  &hml LCTRL D &hml LSHIFT F &kp G        &ltm 4 H  &hmr RSHIFT J &hmr RCTRL K &hmr RALT L   &hmr RGUI SEMI &kp SQT
&kp TAB   &kp Z       &kp X        &kp C        &kp V         &kp B        &kp N     &kp M         &kp COMMA    &kp DOT       &kp FSLH       &kp BSLH
                
&kp LCTRL      &mo 1       &kp SPACE     &kp RET     &mo 1       &mo 2

            >;
        };

        symb1 {
            display-name = "SYMB";
            bindings = <

&kp RET    &kp EXCL       &kp AT           &kp HASH          &kp DLLR         &kp PRCNT          &kp CARET  &kp AMPS    &kp STAR   &kp MINUS &kp UNDER   &kp DEL 
&kp LBRC   &hml LGUI LBKT &hml LALT LPAR   &hml LCTRL RPAR   &hml LSHIFT RBKT &kp RBRC           &tog 4     &trans      &trans     &trans    &trans      &kp PLUS
&kp CAPS   &kp F20        &kp C_MUTE       &kp C_VOL_DN      &kp C_VOL_UP     &kp PSCRN          &kp INS    &kp LEFT    &kp UP     &kp DOWN  &kp RIGHT   &kp EQUAL

&trans        &trans     &kp BSPC        &kp DEL    &trans     &trans 

            >;
        };

        fnct2 {
            display-name = "FNCT";
            bindings = <
             
&kp LA(F4) &kp F1     &kp F2       &kp F3            &kp F4           &kp F5            &kp F6     &kp F7      &kp F8     &kp F9     &kp F10        &trans
&trans     &trans     &trans       &trans            &trans           &caps_word        &caps_word &trans      &trans     &trans     &trans         &kp F12
&trans     &trans     &trans       &kp C_BRI_DN      &kp C_BRI_UP     &trans            &trans     &kp HOME    &kp PG_UP  &kp PG_DN  &kp END        &kp F11

&trans     &trans   &trans             &trans    &trans      &trans

            >;
        };

        ctrl3 {
            display-name = "CTRL";
            bindings = <

&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4         &trans    &out OUT_USB &trans     &trans     &trans     &sys_reset
&trans      &trans        &trans        &trans        &trans        &trans               &trans    &trans       &trans     &kp LG(L)  &trans     &trans
&trans      &trans        &trans        &trans        &trans        &out OUT_BLE         &trans    &trans       &trans     &trans     &trans     &trans

&trans   &trans   &trans         &trans    &trans    &trans

            >;
        };

        num4 {
            display-name = "NUM";
            bindings = <

&kp RET     &kp FSLH      &kp N7        &kp N8        &kp N9        &kp MINUS        &none     &none        &none      &none      &none      &none
&kp BSPC    &kp STAR      &kp N4        &kp N5        &kp N6        &kp PLUS         &tog 4    &kp RSHIFT   &kp RCTRL  &kp RALT   &kp RGUI   &none
&kp EQUAL   &kp COMMA     &kp N1        &kp N2        &kp N3        &kp DOT          &none     &none        &none      &none      &none      &trans

&kp N0   &trans    &trans          &trans    &trans    &trans

            >;
        };
        
        mouse5 {
            display-name = "MOU";
            bindings = <

&trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans

&mkp MCLK &mkp LCLK &mkp RCLK           &mkp LCLK &mkp RCLK &mkp MCLK

            >;
        };
    };
};
